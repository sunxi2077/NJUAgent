ANTHROPIC_API_KEY=replace-with-your-api-key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
MODEL_ID=deepseek-v4-flash
# NJU_AGENT_HOME=~/.nju-agent
AGENT_MAX_STEPS=20
COMMAND_TIMEOUT_MS=120000
TOOL_OUTPUT_MAX_BYTES=32768
UI_OUTPUT_MAX_BYTES=65536
# Context budgeting values are token estimates, not exact counts.
CONTEXT_WINDOW_TOKENS=48000
CONTEXT_COMPACT_RATIO=0.70
CONTEXT_RECENT_MESSAGES=12
CONTEXT_SAFETY_TOKENS=2048

# Optional web search (Tavily). Without a key the web_search tool is not
# registered; queries are sent to an external service when approved.
# TAVILY_API_KEY=replace-with-your-tavily-key
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_MAX_CONTENT_CHARS=6000

# Skills roots: $NJU_AGENT_HOME/skills/<name>/SKILL.md and <workspace>/skills/<name>/SKILL.md
